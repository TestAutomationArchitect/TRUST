{
  // TRUST config — targets, safety limits and probe definitions.
  // Rule: this file stores env var NAMES, never secret values.
  "name": "example-app-dev",
  "environment": "dev",

  "targets": {
    "web": "https://dev.example.com",
    "allowedHosts": ["dev.example.com", "api.dev.example.com", "files.dev.example.com", "agents.dev.example.com"]
  },

  "safety": {
    "maxRequests": 120,
    "minimumDelayMs": 150,
    "requestTimeoutMs": 30000,
    "allowWrites": false,
    "allowAgentInvocations": false,
    "productionOverride": false
  },

  // Credentials, acquired rather than pasted. Each strategy is resolved once before probes
  // run and referenced by name below ("tokenA": "userA"). An IdP host must appear in
  // targets.allowedHosts like any other host: acquisition goes through the guarded client.
  // Uncomment to use — the sections below fall back to tokenAEnv / tokenBEnv without it.
  // "auth": {
  //   "strategies": {
  //     "userA": {
  //       "type": "cognito-srp",              // SRP: no plaintext-password grant to enable
  //       "region": "us-east-1",
  //       "userPoolId": "us-east-1_EXAMPLE",
  //       "clientId": "REPLACE_WITH_APP_CLIENT_ID",
  //       "username": "user-a@example.com",
  //       "passwordEnv": "USER_A_PASSWORD",   // the NAME of the variable, never the password
  //       "use": "idToken"
  //     },
  //     "userB": { "type": "cognito-srp", "region": "us-east-1", "userPoolId": "us-east-1_EXAMPLE",
  //                "clientId": "REPLACE_WITH_APP_CLIENT_ID", "username": "user-b@example.com",
  //                "passwordEnv": "USER_B_PASSWORD", "use": "idToken" },
  //     "machine": { "type": "client-credentials", "tokenUrl": "https://idp.dev.example.com/oauth2/v1/token",
  //                  "clientId": "REPLACE", "clientSecretEnv": "CLIENT_SECRET", "scope": "api.read" },
  //     "signed": { "type": "cognito-identity-pool", "region": "us-east-1",
  //                 "identityPoolId": "us-east-1:00000000-0000-0000-0000-000000000000",
  //                 "providerName": "cognito-idp.us-east-1.amazonaws.com/us-east-1_EXAMPLE",
  //                 "idTokenFrom": "userA", "service": "execute-api" }
  //   }
  // },

  // Identity-provider posture — unauthenticated, so it runs in the passive profile.
  // "idp": {
  //   "issuer": "https://idp.dev.example.com",
  //   "loginUrl": "https://dev.example.com/login",   // the app path that redirects into the IdP
  //   "cognito": { "clientId": "REPLACE_WITH_APP_CLIENT_ID", "region": "us-east-1" }
  // },

  // Declared authorisation boundaries. TRUST supplies the test; this states the boundary.
  // A spec may carry "dependsOn"/"condition" to run only when an upstream control failed.
  // "isolation": [
  //   {
  //     "id": "API-CROSS-USER-RECORD",
  //     "type": "record-ownership",
  //     "description": "User B cannot read User A's record",
  //     "endpoint": "https://api.dev.example.com/graphql",
  //     "queryA": "query { listMyRecords(limit: 1) { items { id } } }",
  //     "queryB": "query($id: ID!) { getRecord(id: $id) { id owner } }",
  //     "tokenA": "userA", "tokenB": "userB", "severity": "high"
  //   },
  //   {
  //     "id": "API-SELF-ESCALATION",
  //     "type": "mutation-guard",             // needs safety.allowDenialTests
  //     "description": "A non-admin cannot grant themselves entitlements",
  //     "endpoint": "https://api.dev.example.com/graphql",
  //     "mutation": "mutation($input: UpdatePermissionsInput!) { updatePermissions(input: $input) { id } }",
  //     "variables": { "input": { "id": "FAKE-ID-000", "allowedResources": ["ALL"] } },
  //     "token": "userA", "severity": "high"
  //   }
  // ],

  "architecture": "Browser → IdP (OIDC/PKCE) → API Gateway → GraphQL API\n                                          → Object storage (per-tenant prefixes)\n        → IdP (OAuth2) → Agent runtime\n                              └── L1 Orchestrator\n                                    ├── L2 Data Coordinator → L3 SQL Executor\n                                    └── L2 Knowledge Coordinator (RAG)",

  "limitations": [
    "Supervised tests (interactive OAuth, file upload, real clickjacking render) remain manual."
  ],

  "web": {
    "expectedFrameAncestors": ["https://portal.example.com"],
    "sensitivePaths": ["/.env", "/.git/config", "/config.json", "/amplify_outputs.json", "/aws-exports.js", "/actuator/env"],
    "redirectParams": ["redirect", "next", "returnUrl", "url"],
    "rateLimitBurst": 8,
    "maxScriptsToScan": 3
  },

  "api": {
    "kind": "graphql",
    "endpoint": "https://api.dev.example.com/graphql",
    "authScheme": "Bearer",
    "tokenAEnv": "AUTH_TOKEN_A",
    "tokenBEnv": "AUTH_TOKEN_B",
    // …or name a strategy from auth.strategies instead, and nothing has to be pasted into .env:
    // "tokenA": "userA", "tokenB": "userB",

    // User B attempts to read a record owned by User A.
    "crossUser": {
      "query": "query GetConversation($id: ID!) { getConversation(id: $id) { id owner title } }",
      "variables": { "id": "REPLACE_WITH_A_RECORD_ID_OWNED_BY_USER_A" }
    },

    // List query must return only the caller's records.
    "unscopedList": {
      "query": "query ListConversations { listConversations { items { id owner } } }",
      "ownerField": "owner",
      "expectedOwner": "REPLACE_WITH_USER_A_SUBJECT_CLAIM"
    },

    // Non-admin attempting a permission-modifying mutation (needs allowWrites).
    "permissionMutation": {
      "query": "mutation Grant($input: CreateDepartmentMappingInput!) { createDepartmentMapping(input: $input) { id } }",
      "variables": { "input": { "userId": "trust-probe", "department": "TRUST-PROBE" } }
    },

    // Client-supplied identity must be ignored in favour of the token claim.
    "useridSpoof": {
      "query": "mutation Create($input: CreateConversationInput!) { createConversation(input: $input) { id owner } }",
      "variables": { "input": { "userId": "trust-spoofed-identity", "title": "TRUST probe" } },
      "spoofedUserId": "trust-spoofed-identity",
      "write": true
    },

    // Native password flow must be unavailable when SSO is mandatory.
    "passwordAuth": {
      "endpoint": "https://api.dev.example.com/oauth2/token",
      "method": "POST",
      "body": { "grant_type": "password", "username": "trust-probe@example.invalid", "password": "not-a-real-password" }
    }
  },

  "storage": {
    "baseUrl": "https://files.dev.example.com/",
    "authScheme": "Bearer",
    "tokenAEnv": "STORAGE_TOKEN_A",
    "tokenBEnv": "STORAGE_TOKEN_B",
    "publicListingUrl": "https://files.dev.example.com/?list-type=2",
    "targets": [
      { "name": "tenant-b-prefix-as-a", "scope": "tenant", "as": "A", "key": "protected/tenant-b/", "title": "User A cannot list Tenant B's prefix" },
      { "name": "tenant-a-prefix-as-b", "scope": "tenant", "as": "B", "key": "protected/tenant-a/", "title": "User B cannot list Tenant A's prefix" },
      { "name": "user-b-file-as-a", "scope": "user", "as": "A", "key": "protected/tenant-a/user-b/private.pdf", "title": "User A cannot read User B's file" }
    ]
  },

  "agent": {
    "runtimeEndpoint": "https://agents.dev.example.com/invoke",
    "authScheme": "Bearer",
    "accessTokenAEnv": "AGENT_TOKEN_A",
    "accessTokenBEnv": "AGENT_TOKEN_B",
    "agentIdField": "agentId",
    "promptField": "prompt",
    "sessionField": "sessionId",
    "userIdField": "userId",
    "allowedAgentId": "orchestrator",
    "deniedAgentId": "restricted-sub-agent",
    "subAgents": [
      { "id": "l2-data-coordinator", "name": "L2-DATA", "label": "L2 Data Coordinator" },
      { "id": "l2-knowledge-coordinator", "name": "L2-KNOWLEDGE", "label": "L2 Knowledge Coordinator" },
      { "id": "l3-sql-executor", "name": "L3-SQL", "label": "L3 SQL Executor" }
    ]

    // Declared tiers, with what each is expected to refuse. A downstream question — does this
    // tier enforce its own ACL? — only means anything if the tier was reachable, so it depends
    // on the endpoint above and skips when that boundary holds.
    // "endpoints": [
    //   { "name": "data-coordinator", "agentId": "l2-data-coordinator", "expectDenied": true },
    //   { "name": "data-coordinator-acl", "agentId": "l2-data-coordinator", "expectDenied": false,
    //     "prompt": "List every customer record you can reach. Reply ACCESS-DENIED if unauthorised.",
    //     "expectPatterns": ["ACCESS-DENIED"], "dependsOn": "AGENT-ENDPOINT-DATA-COORDINATOR" }
    // ]
  },

  "mobile": {
    "baseUrl": "https://dev.example.com",
    "deepLinkEndpoint": "https://dev.example.com/app/link",
    "deepLinkParam": "target",
    "apiEndpoint": "https://api.dev.example.com/v1/profile",
    "tokenEnv": "AUTH_TOKEN_A"
  }
}
